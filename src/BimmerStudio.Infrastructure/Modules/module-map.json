{
  // Maps raw SGBD file names to vehicle modules. Neutral data only: the localised names live in
  // the language packs as Module_<key> and Category_<key>, so they follow the selected language.
  //
  // Rules are evaluated in order, first match wins. Matching is case-insensitive against the
  // base name without extension. Only confidently known names are mapped — an unmapped name
  // falls into "other" and is shown raw, which is honest; a wrong friendly name is worse than
  // none. BMW's family tokens (DDE always means diesel engine electronics, KOMBI always the
  // cluster) make the substring rules safe for the families listed here.

  "categoryOrder": [
    "engine",
    "transmission",
    "chassis",
    "body",
    "access",
    "safety",
    "climate",
    "infotainment",
    "network",
    "other"
  ],

  "modules": {
    "motor": "engine",
    "dme": "engine",
    "dde": "engine",
    "mss": "engine",
    "ekp": "engine",
    "vvt": "engine",

    "egs": "transmission",
    "smg": "transmission",
    "vgsg": "transmission",
