<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BimmerStudio.App.ViewModels"
             xmlns:help="using:BimmerStudio.App.Help"
             xmlns:loc="using:BimmerStudio.App.Localization"
             x:Class="BimmerStudio.App.Views.SgbdBrowserView"
             x:DataType="vm:SgbdBrowserViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
    </Style>
    <Style Selector="TextBlock.panelHeading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Border.kindBadge">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- ECU selection. Choosing loads immediately: reading a description file cannot change
         the vehicle, so there is nothing to confirm with a second button. -->
    <Border Grid.Row="0" Padding="12" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" IsIndeterminate="True"
                     VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
        <TextBlock DockPanel.Dock="Left" Text="{loc:T Browser_Ecu}" VerticalAlignment="Center"
                   Margin="0,0,8,0" Opacity="0.7" />
        <ComboBox ItemsSource="{Binding AvailableSgbds}"
                  SelectedItem="{Binding SelectedSgbd}"
                  HorizontalAlignment="Stretch"
                  MaxDropDownHeight="420"
                  help:Help.TopicId="sgbd-browser/ecu">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SgbdListItemViewModel">
              <DockPanel MinWidth="260" ToolTip.Tip="{Binding KindDescription}">
                <Border DockPanel.Dock="Right" Classes="kindBadge"
                        Background="{Binding KindBrush}">
                  <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="Black" />
                </Border>
                <TextBlock Text="{Binding DisplayName}" Classes="mono" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
              </DockPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="320,4,*">

      <!-- Job list -->
      <DockPanel Grid.Column="0" Margin="12" help:Help.TopicId="sgbd-browser">
        <TextBox DockPanel.Dock="Top" Watermark="{loc:T Browser_FilterJobs}" Text="{Binding JobFilter}"
                 Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" Opacity="0.6"
                   Text="{Binding VariantLabel}"
                   IsVisible="{Binding VariantLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:JobListItemViewModel">
              <StackPanel Spacing="2" Margin="0,2">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Classes="kindBadge"
                          Background="{Binding SafetyBrush}"
                          ToolTip.Tip="{Binding SafetyDescription}">
                    <TextBlock Text="{Binding SafetyLabel}" FontSize="10" Foreground="Black" />
                  </Border>
                  <TextBlock Text="{Binding Name}" Classes="mono"
                             FontSize="12" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <!-- Translated summary; the German original stays reachable as the tooltip. -->
                <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding OriginalSummary}"
                           IsVisible="{Binding HasSummary}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="#2A2A2A" />

      <!-- Execution and results. One scroll viewer over the whole pane so a narrow window
           scrolls both ways rather than clipping the byte-layout tables. -->
      <ScrollViewer Grid.Column="2" Margin="12"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" MinWidth="520">

          <TextBlock Text="{loc:T Browser_SelectEcuPrompt}" FontSize="12" Opacity="0.5"
                     TextWrapping="Wrap"
                     IsVisible="{Binding SelectedJob, Converter={x:Static ObjectConverters.IsNull}}" />

          <!-- Job identity: the protocol name, then what the ECU file says it does. -->
          <StackPanel Spacing="2" help:Help.TopicId="sgbd-browser"
                      IsVisible="{Binding SelectedJob, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding SelectedJob.Name}" FontSize="18" FontWeight="SemiBold"
                       Classes="mono" />
            <TextBlock Text="{Binding SelectedJob.FullDescription}" FontSize="12" Opacity="0.75"
                       TextWrapping="Wrap"
                       ToolTip.Tip="{Binding SelectedJob.OriginalSummary}"
                       IsVisible="{Binding SelectedJob.HasSummary, FallbackValue=False}" />
            <TextBlock Text="{loc:T Browser_NoDescription}" FontSize="12" Opacity="0.45"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !SelectedJob.HasSummary, FallbackValue=False}" />
          </StackPanel>

          <TextBox Watermark="{loc:T Browser_ArgumentsWatermark}" Text="{Binding Arguments}"
                   IsVisible="{Binding SelectedJob, Converter={x:Static ObjectConverters.IsNotNull}}"
                   help:Help.TopicId="sgbd-browser/arguments" />

          <!-- What the selected job accepts, straight from the SGBD's own declaration. -->
          <Border Background="#161D26" CornerRadius="4" Padding="10"
                  IsVisible="{Binding SelectedJob, Converter={x:Static ObjectConverters.IsNotNull}}"
                  help:Help.TopicId="sgbd-browser/arguments">
            <StackPanel Spacing="4">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:T Browser_InsertTemplate}"
                        FontSize="11" Padding="8,3"
                        Command="{Binding InsertArgumentTemplateCommand}"
                        IsVisible="{Binding SelectedJob.HasArguments, FallbackValue=False}" />
                <TextBlock Text="{loc:T Browser_DeclaredArguments}" Classes="panelHeading"
                           VerticalAlignment="Center" />
              </DockPanel>

              <TextBlock Text="{loc:T Browser_NoArgumentsDeclared}" FontSize="12" Opacity="0.55"
                         TextWrapping="Wrap"
                         IsVisible="{Binding !SelectedJob.HasArguments, FallbackValue=False}" />

              <ItemsControl ItemsSource="{Binding SelectedJob.Arguments, FallbackValue={x:Null}}"
                            IsVisible="{Binding SelectedJob.HasArguments, FallbackValue=False}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:JobParameterViewModel">
                    <Grid ColumnDefinitions="170,90,*" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="mono" FontSize="12"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="11" Opacity="0.6"
                                 VerticalAlignment="Top" />
                      <!-- One documented line per display line: the byte-layout descriptions are
                           tables in the source and must not be flattened into prose. -->
                      <TextBlock Grid.Column="2" Text="{Binding Comment}" FontSize="12" Opacity="0.85"
                                 TextWrapping="Wrap" LineHeight="17"
                                 ToolTip.Tip="{Binding OriginalComment}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- What the job will return, before it is run. -->
          <Border Background="#161616" CornerRadius="4" Padding="10"
                  IsVisible="{Binding SelectedJob.HasDocumentedResults, FallbackValue=False}">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:T Browser_DocumentedResults}" Classes="panelHeading" />
              <ItemsControl ItemsSource="{Binding SelectedJob.DocumentedResults, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:JobParameterViewModel">
                    <Grid ColumnDefinitions="220,90,*" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="mono" FontSize="12"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="11" Opacity="0.6"
                                 VerticalAlignment="Top" />
                      <TextBlock Grid.Column="2" Text="{Binding Comment}" FontSize="12" Opacity="0.85"
                                 TextWrapping="Wrap" LineHeight="17"
                                 ToolTip.Tip="{Binding OriginalComment}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Why Run is unavailable, rather than a silently disabled button. -->
          <Border Background="#3A1F1F" CornerRadius="4" Padding="10"
                  IsVisible="{Binding BlockedReason, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding BlockedReason}" TextWrapping="Wrap"
                       Foreground="#F0A0A0" FontSize="12" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding SelectedJob, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Button Content="{loc:T Browser_RunOnce}" Classes="accent" Command="{Binding RunOnceCommand}" />
            <Button Content="{loc:T Browser_RunContinuously}" Command="{Binding RunContinuousCommand}"
                    IsVisible="{Binding !IsStreaming}" />
            <Button Content="{loc:T Browser_Stop}" Command="{Binding StopContinuousCommand}"
                    IsVisible="{Binding IsStreaming}" />
            <Button Content="{loc:T Browser_ClearResults}" Command="{Binding ClearResultsCommand}"
                    IsVisible="{Binding SelectedJob.HasRun, FallbackValue=False}" />
            <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="12"
                       Text="{Binding SelectedJob.RunCountLabel}" />
            <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="12"
                       Text="{Binding SelectedJob.LastDuration}" />
          </StackPanel>

          <TextBlock Text="{loc:T Browser_NoResultsYet}" FontSize="12" Opacity="0.45"
                     TextWrapping="Wrap" Margin="0,4"
                     IsVisible="{Binding !SelectedJob.HasRun, FallbackValue=False}" />

          <!-- Results of the selected job, bound through the selection so switching jobs shows
               that job's own output instead of leaving the previous job's on screen. -->
          <ItemsControl ItemsSource="{Binding SelectedJob.Results, FallbackValue={x:Null}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ResultSetViewModel">
                <Border Background="#161616" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Classes="panelHeading" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResultRowViewModel">
                          <Grid ColumnDefinitions="200,220,*" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="mono"
                                       FontSize="12" Opacity="0.75"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                            <!-- System results are a fixed set the interpreter produces for
                                 every job, so each carries a localised explanation. -->
                            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11"
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,0,12,0"
                                       VerticalAlignment="Top"
                                       IsVisible="{Binding HasDescription}" />
                            <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas,Menlo,monospace" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
